# Скопіюйте цей файл у .env і змініть значення за потреби. Сам .env у git не потрапляє.

# Порт, на якому працює API
PORT=3001

# Адреси React-клієнта, яким дозволено звертатися до API (CORS), через кому:
# 5173 — npm run dev, 4173 — npm run preview (production-збірка для Lighthouse)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
