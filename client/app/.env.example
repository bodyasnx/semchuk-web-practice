# Скопіюйте у .env (той самий каталог). Сам .env у git не потрапляє.
# Адреса REST API (server/). Vite вбудовує змінні VITE_* у збірку, тож секретів тут бути не може.
VITE_API_URL=http://localhost:3001

# Адреса сайту після деплою (ПР 10) для canonical, og:url і JSON-LD. Без неї — адреса, з якої відкрито сторінку.
# VITE_SITE_URL=https://smak-tradytsii.example
